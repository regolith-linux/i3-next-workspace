#!/usr/bin/env python3

import i3ipc
import argparse
import subprocess
import re
import sys


def quote(name):
    """Quote a workspace name as one argument of an i3 command."""
    return '"' + name.replace('\\', '\\\\').replace('"', '\\"') + '"'


def run_command(i3, command):
    """Run an i3 command; return False and report on stderr if i3 rejects it."""
    ok = True
    for reply in i3.command(command):
        if not reply.success:
            print(f"i3-next-workspace: i3 rejected '{command}': {reply.error}",
                  file=sys.stderr)
            ok = False
    return ok


if __name__ == "__main__":

    parser = argparse.ArgumentParser(
            description = "Find the next non-opened workspace and go there.")
    parser.add_argument('-s','--startnum',type=int,default = 1,
        help="DEPRECATED")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("-mv","--move-window",action="store_true",
            help="Instead of going to next non-opened workspace, move current window there.")
    group.add_argument("-mvf","--move-window-and-follow",action="store_true",
            help="Move current window to next non-opened workspace and follow.")
    args = parser.parse_args()
   
    # Get names of the Xserver
    mapping_names = {}
    output, err = subprocess.Popen(["xrdb","-query"],stdout=subprocess.PIPE).communicate()
    output = output.decode().split("\n")
    output = [
            line.split("\t")[1] 
            for line in output 
            if re.search(r"wm\.workspace\...\.name:",line)
            ]
    mapping_names = {}
    for line in output:
        if ":" in line:
            # the label may itself contain colons, e.g. "1:Chat: Work"
            key, value = line.split(":", 1)
            mapping_names[int(key)] = value
        else:
            mapping_names[int(line)] = line

    # without workspace-name resources, workspaces are plain numbers from 1
    startnum = min(mapping_names.keys(), default=1)
    i3 = i3ipc.Connection()
    workspaces = i3.get_workspaces()
    nums = {w.num for w in workspaces}
    # first free number, with no upper limit
    targetnum = startnum
    while targetnum in nums:
        targetnum += 1
    try:
        targetstring = f"{targetnum}:{mapping_names[targetnum]}"
    except KeyError:
        targetstring = f"{targetnum}:{targetnum}"

    # like a chain of i3 commands, run them all, then fail if any was rejected
    ok = True
    if args.move_window or args.move_window_and_follow:
        ok &= run_command(i3, "move container workspace " + quote(targetstring))
    if not args.move_window:
        ok &= run_command(i3, "workspace number " + quote(targetstring))
    sys.exit(0 if ok else 1)

